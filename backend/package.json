{
  "name": "stayease-backend",
  "version": "1.0.0",
  "private": true,
  "description": "StayEase hotel booking and reservation management API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/db-guard.js \"run prisma migrate dev (it can reset the database)\" && node scripts/prisma.js migrate dev",
    "db:deploy": "node scripts/prisma.js migrate deploy",
    "db:status": "node scripts/prisma.js migrate status",
    "db:seed": "node prisma/seed.js",
    "db:seed:prod": "node scripts/seed-if-empty.js",
    "db:reset": "node scripts/reset-local-db.js",
    "test": "node --test --test-concurrency=1 tests/",
    "db:backup": "node scripts/backup-db.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
