# ─── Server ───
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000          # public URL of the site (used in emails & payment redirects)
HOTEL_TIMEZONE=Asia/Manila
SESSION_SECRET=change-me-to-a-long-random-string
TRUST_PROXY=false                      # true/number of proxy hops; defaults to 1 on Vercel (needed for secure cookies)

# ─── Database: PostgreSQL ───
# Vercel: the Neon integration sets both variables automatically. Never commit real values.
#   DATABASE_URL          = POOLED connection (host contains "-pooler"), used by the app at runtime
#   DATABASE_URL_UNPOOLED = DIRECT connection (no "-pooler"), used only by prisma migrate
# Local development: a PostgreSQL server on this machine (both variables can be the same).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stayease_db"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/stayease_db"

# ─── Auth behaviour ───
REQUIRE_EMAIL_VERIFICATION_FOR_BOOKING=true

# ─── Email: Brevo (https://app.brevo.com → SMTP & API → API keys) ───
# Leave BREVO_API_KEY empty in development: emails are printed to the server console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@stayease.example
MAIL_FROM_NAME=StayEase

# ─── Images: Cloudinary (https://console.cloudinary.com) ───
# Leave empty to store uploads on local disk (backend/storage/uploads, served at /uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stayease

# ─── Payments ───
# PAYMENT_PROVIDER=mock    → built-in simulated hosted checkout (development/demo only; disabled in production)
# PAYMENT_PROVIDER=paymongo → PayMongo Checkout (GCash, Maya, cards). Requires keys below.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false

# ─── Operations ───
RUN_JOBS=true                  # local server timers (hold expiry, reminders, cleanup); set false on extra app instances
# CRON_SECRET=                 # Vercel: random 32+ chars; enables GET /api/cron/:job (Vercel Cron sends it as a Bearer token)
# MIGRATE_ON_BUILD=            # Vercel Production only: "true" runs `prisma migrate deploy` during the build (never resets data)
# PG_DUMP_PATH=                # path to pg_dump for `npm run db:backup` (default: pg_dump on PATH)
# BACKUP_DIR=                  # default backend/storage/backups
# BACKUP_RETENTION=14          # number of backups to keep
# TEST_DATABASE_URL=           # LOCAL database for npm test (it is wiped on every run); default: same local server, database stayease_test

# ─── Social sign-in (optional; each button appears on login/register only once its keys are set) ───
# Google: https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: {APP_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com → Create app → Facebook Login → Valid OAuth Redirect URI:
#   {APP_URL}/api/v1/auth/oauth/facebook/callback   (HTTPS required except on localhost)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v19.0

# ─── Database schema (optional) ───
# Neon production: DATABASE_SCHEMA=stayease keeps StayEase's tables in their own schema, separate from other
# data in the same database (unset = "public"). Applied to the app, migrations and raw SQL alike.
# DATABASE_SCHEMA=
