# ─── Server ───
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000          # public URL of the site (used in emails & payment redirects)
HOTEL_TIMEZONE=Asia/Manila
SESSION_SECRET=change-me-to-a-long-random-string
TRUST_PROXY=false                      # set true behind a reverse proxy / load balancer (needed for secure cookies)

# ─── Database (XAMPP MySQL/MariaDB locally) ───
DATABASE_URL="mysql://root:@localhost:3306/stayease_db"

# ─── Auth behaviour ───
REQUIRE_EMAIL_VERIFICATION_FOR_BOOKING=true

# ─── Email: Brevo (https://app.brevo.com → SMTP & API → API keys) ───
# Leave BREVO_API_KEY empty in development: emails are printed to the server console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@stayease.example
MAIL_FROM_NAME=StayEase

# ─── Images: Cloudinary (https://console.cloudinary.com) ───
# Leave empty to store uploads on local disk (backend/storage/uploads, served at /uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stayease

# ─── Payments ───
# PAYMENT_PROVIDER=mock    → built-in simulated hosted checkout (development/demo only; disabled in production)
# PAYMENT_PROVIDER=paymongo → PayMongo Checkout (GCash, Maya, cards). Requires keys below.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVE_MODE=false

# ─── Operations ───
RUN_JOBS=true                  # hold-expiry + check-in reminder jobs; set false on extra app instances
# MYSQLDUMP_PATH=              # path to mysqldump for `npm run db:backup` (auto-detects XAMPP on Windows)
# BACKUP_DIR=                  # default backend/storage/backups
# BACKUP_RETENTION=14          # number of backups to keep
# TEST_DATABASE_URL=           # default: same server, database stayease_test
