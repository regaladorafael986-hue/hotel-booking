// StayEase — single-hotel booking & reservation management
// Database: PostgreSQL (Neon). Monetary values use NUMERIC(12,2).
// The original MySQL migrations are archived in prisma/migrations-mysql (history only, never applied).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (-pooler host)
  directUrl = env("DIRECT_URL")   // Neon direct connection, used by prisma migrate
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  RECEPTIONIST
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum RoomTypeStatus {
  ACTIVE
  ARCHIVED
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING_PAYMENT // online booking holding inventory until expires_at
  PENDING_CONFIRMATION // pay-at-hotel booking awaiting manual confirmation (hotel policy)
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum BookingPaymentMethod {
  ONLINE
  PAY_AT_HOTEL
}

enum BookingSource {
  ONLINE
  WALK_IN
}

enum CancellationStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ───────────────────────────── Users & auth ─────────────────────────────

model User {
  id              Int           @id @default(autoincrement())
  firstName       String        @map("first_name") @db.VarChar(80)
  lastName        String        @map("last_name") @db.VarChar(80)
  email           String        @unique @db.VarChar(191)
  phone           String?       @db.VarChar(30)
  passwordHash    String?       @map("password_hash") @db.VarChar(255) // null for social-login-only accounts
  role            Role          @default(CUSTOMER)
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")
  permissions     Json? // receptionist permission keys, e.g. ["check_in","collect_payment"]
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  bookings        Booking[]      @relation("BookingCustomer")
  createdBookings Booking[]      @relation("BookingCreatedBy")
  reviews         Review[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  tokens          AuthToken[]
  oauthAccounts   OAuthAccount[]
  paymentsRecorded Payment[]     @relation("PaymentRecordedBy")

  @@index([role])
  @@index([accountStatus])
  @@index([lastName, firstName])
  @@map("users")
}

// External sign-in identities (Google, Facebook) linked to a StayEase user.
model OAuthAccount {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  provider       String   @db.VarChar(20) // google | facebook
  providerUserId String   @map("provider_user_id") @db.VarChar(191)
  email          String?  @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at")
  lastUsedAt     DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      TokenType
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Session {
  sid       String   @id @db.VarChar(128)
  data      String   @db.Text
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── Hotel ─────────────────────────────

model HotelSettings {
  id                    Int      @id @default(autoincrement())
  hotelName             String   @map("hotel_name") @db.VarChar(120)
  tagline               String?  @db.VarChar(200)
  description           String?  @db.Text
  address               String?  @db.VarChar(255)
  contactNumber         String?  @map("contact_number") @db.VarChar(40)
  email                 String?  @db.VarChar(191)
  checkInTime           String   @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime          String   @default("12:00") @map("check_out_time") @db.VarChar(5)
  cancellationPolicy    String?  @map("cancellation_policy") @db.Text
  hotelPolicies         String?  @map("hotel_policies") @db.Text
  freeCancellationHours Int      @default(48) @map("free_cancellation_hours")
  taxRate               Decimal  @default(12.00) @map("tax_rate") @db.Decimal(5, 2) // percent
  currency              String   @default("PHP") @db.VarChar(3)
  payAtHotelAutoConfirm Boolean  @default(true) @map("pay_at_hotel_auto_confirm")
  holdMinutes           Int      @default(15) @map("hold_minutes")
  mapEmbedUrl           String?  @map("map_embed_url") @db.VarChar(500)
  facebookUrl           String?  @map("facebook_url") @db.VarChar(255)
  instagramUrl          String?  @map("instagram_url") @db.VarChar(255)
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("hotel_settings")
}

model HotelImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url") @db.VarChar(500)
  publicId  String?  @map("public_id") @db.VarChar(255)
  caption   String?  @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("hotel_images")
}

// ───────────────────────────── Rooms ─────────────────────────────

model RoomType {
  id               Int            @id @default(autoincrement())
  name             String         @unique @db.VarChar(100)
  slug             String         @unique @db.VarChar(120)
  shortDescription String?        @map("short_description") @db.VarChar(255)
  description      String?        @db.Text
  basePrice        Decimal        @map("base_price") @db.Decimal(12, 2)
  maxAdults        Int            @map("max_adults")
  maxChildren      Int            @default(0) @map("max_children")
  bedType          String         @map("bed_type") @db.VarChar(60)
  sizeSqm          Int?           @map("size_sqm")
  isFeatured       Boolean        @default(false) @map("is_featured")
  status           RoomTypeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  rooms        Room[]
  images       RoomImage[]
  amenities    RoomTypeAmenity[]
  bookingRooms BookingRoom[]

  @@index([status])
  @@index([basePrice])
  @@map("room_types")
}

model Room {
  id                 Int                @id @default(autoincrement())
  roomTypeId         Int                @map("room_type_id")
  roomNumber         String             @unique @map("room_number") @db.VarChar(20)
  floor              Int
  housekeepingStatus HousekeepingStatus @default(CLEAN) @map("housekeeping_status")
  isActive           Boolean            @default(true) @map("is_active")
  notes              String?            @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  bookingRooms BookingRoom[]

  @@index([roomTypeId, isActive])
  @@map("rooms")
}

model RoomImage {
  id         Int      @id @default(autoincrement())
  roomTypeId Int      @map("room_type_id")
  imageUrl   String   @map("image_url") @db.VarChar(500)
  publicId   String?  @map("public_id") @db.VarChar(255)
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@map("room_images")
}

model Amenity {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(80)
  icon        String? @db.VarChar(40)
  description String? @db.VarChar(255)

  roomTypes RoomTypeAmenity[]

  @@map("amenities")
}

model RoomTypeAmenity {
  id         Int @id @default(autoincrement())
  roomTypeId Int @map("room_type_id")
  amenityId  Int @map("amenity_id")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
  @@index([amenityId])
  @@map("room_type_amenities")
}

// ───────────────────────────── Bookings ─────────────────────────────

model Booking {
  id                    Int                  @id @default(autoincrement())
  bookingReference      String               @unique @map("booking_reference") @db.VarChar(20)
  userId                Int?                 @map("user_id") // null for walk-in guests without an account
  createdById           Int?                 @map("created_by_id")
  source                BookingSource        @default(ONLINE)
  guestFirstName        String               @map("guest_first_name") @db.VarChar(80)
  guestLastName         String               @map("guest_last_name") @db.VarChar(80)
  guestEmail            String               @map("guest_email") @db.VarChar(191)
  guestPhone            String?              @map("guest_phone") @db.VarChar(30)
  specialRequests       String?              @map("special_requests") @db.Text
  checkIn               DateTime             @map("check_in") @db.Date
  checkOut              DateTime             @map("check_out") @db.Date
  nights                Int
  adults                Int
  children              Int                  @default(0)
  totalRooms            Int                  @map("total_rooms")
  subtotal              Decimal              @db.Decimal(12, 2)
  discount              Decimal              @default(0) @db.Decimal(12, 2)
  taxes                 Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal              @map("total_amount") @db.Decimal(12, 2)
  amountPaid            Decimal              @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountRefunded        Decimal              @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  couponId              Int?                 @map("coupon_id")
  couponCode            String?              @map("coupon_code") @db.VarChar(40)
  bookingStatus         BookingStatus        @map("booking_status")
  paymentStatus         PaymentStatus        @default(PENDING) @map("payment_status")
  paymentMethod         BookingPaymentMethod @map("payment_method")
  expiresAt             DateTime?            @map("expires_at")
  confirmedAt           DateTime?            @map("confirmed_at")
  checkedInAt           DateTime?            @map("checked_in_at")
  checkedOutAt          DateTime?            @map("checked_out_at")
  cancelledAt           DateTime?            @map("cancelled_at")
  cancellationStatus    CancellationStatus   @default(NONE) @map("cancellation_status")
  cancellationReason    String?              @map("cancellation_reason") @db.Text
  cancellationRequestedAt DateTime?          @map("cancellation_requested_at")
  cancellationNote      String?              @map("cancellation_note") @db.Text
  reminderSentAt        DateTime?            @map("reminder_sent_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user          User?          @relation("BookingCustomer", fields: [userId], references: [id])
  createdBy     User?          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  coupon        Coupon?        @relation(fields: [couponId], references: [id])
  rooms         BookingRoom[]
  payments      Payment[]
  review        Review?
  notifications Notification[]

  @@index([userId])
  @@index([checkIn, checkOut])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([expiresAt])
  @@index([guestLastName, guestFirstName])
  @@index([createdAt])
  @@map("bookings")
}

model BookingRoom {
  id          Int     @id @default(autoincrement())
  bookingId   Int     @map("booking_id")
  roomId      Int     @map("room_id") // physical room assignment — source of truth for availability
  roomTypeId  Int     @map("room_type_id")
  nightlyRate Decimal @map("nightly_rate") @db.Decimal(12, 2)
  adults      Int
  children    Int     @default(0)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
  @@index([roomId])
  @@index([roomTypeId])
  @@map("booking_rooms")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id               Int           @id @default(autoincrement())
  bookingId        Int           @map("booking_id")
  paymentReference String        @unique @map("payment_reference") @db.VarChar(40)
  provider         String        @db.VarChar(30) // PAYMONGO | MOCK | FRONT_DESK
  providerSessionId String?      @unique @map("provider_session_id") @db.VarChar(120)
  providerPaymentId String?      @map("provider_payment_id") @db.VarChar(120)
  checkoutUrl      String?       @map("checkout_url") @db.VarChar(500)
  amount           Decimal       @db.Decimal(12, 2)
  amountRefunded   Decimal       @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  paymentMethod    String?       @map("payment_method") @db.VarChar(30) // GCASH | MAYA | CARD | CASH | ...
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  failureReason    String?       @map("failure_reason") @db.VarChar(255)
  recordedById     Int?          @map("recorded_by_id")
  notes            String?       @db.VarChar(255)
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  booking    Booking  @relation(fields: [bookingId], references: [id])
  recordedBy User?    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  refunds    Refund[]

  @@index([bookingId])
  @@index([paymentStatus])
  @@index([paidAt])
  @@map("payments")
}

// Every processed webhook event id is stored once → idempotent webhook handling.
model PaymentEvent {
  id          Int      @id @default(autoincrement())
  provider    String   @db.VarChar(30)
  eventId     String   @map("event_id") @db.VarChar(120)
  eventType   String   @map("event_type") @db.VarChar(80)
  payload     String   @db.Text
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@map("payment_events")
}

model Refund {
  id                Int          @id @default(autoincrement())
  paymentId         Int          @map("payment_id")
  amount            Decimal      @db.Decimal(12, 2)
  reason            String?      @db.VarChar(255)
  refundStatus      RefundStatus @default(PENDING) @map("refund_status")
  providerReference String?      @map("provider_reference") @db.VarChar(120)
  processedById     Int?         @map("processed_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([refundStatus])
  @@map("refunds")
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id        Int          @id @default(autoincrement())
  bookingId Int          @unique @map("booking_id") // one review per booking
  userId    Int          @map("user_id")
  rating    Int          @db.SmallInt
  title     String?      @db.VarChar(120)
  comment   String?      @db.Text
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("reviews")
}

model Coupon {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(40)
  description     String?      @db.VarChar(255)
  discountType    DiscountType @map("discount_type")
  discountValue   Decimal      @map("discount_value") @db.Decimal(12, 2)
  minimumAmount   Decimal      @default(0) @map("minimum_amount") @db.Decimal(12, 2)
  maximumDiscount Decimal?     @map("maximum_discount") @db.Decimal(12, 2)
  usageLimit      Int?         @map("usage_limit")
  usedCount       Int          @default(0) @map("used_count")
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date
  isFeatured      Boolean      @default(false) @map("is_featured")
  status          CouponStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([status, startDate, endDate])
  @@map("coupons")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookingId Int?     @map("booking_id")
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @db.VarChar(40) // BOOKING | PAYMENT | REMINDER | SYSTEM
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(40)
  description String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
