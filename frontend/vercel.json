{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix ../backend --include=dev",
  "buildCommand": "node ../backend/scripts/vercel-build.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/:page((?!api(?:/|$))[^.]+)", "destination": "/:page.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self';script-src 'self';style-src 'self' https://fonts.googleapis.com 'unsafe-inline';font-src 'self' https://fonts.gstatic.com data:;img-src 'self' data: blob: https://images.unsplash.com https://res.cloudinary.com;connect-src 'self';frame-src https://www.google.com https://maps.google.com;form-action 'self';upgrade-insecure-requests;base-uri 'self';frame-ancestors 'self';object-src 'none';script-src-attr 'none'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Download-Options", "value": "noopen" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "X-XSS-Protection", "value": "0" }
      ]
    }
  ]
}
